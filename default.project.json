{
	"name": "roblox-ts-game",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js",
						"React": {
							"$path": "node_modules/@rbxts-js/react/src"
						},
						"ReactRoblox": {
							"$path": "node_modules/@rbxts-js/react-roblox/src"
						},
						"ReactGlobals": {
							"$path": "node_modules/@rbxts-js/react-globals/src"
						},
						"ReactReconciler": {
							"$path": "node_modules/@rbxts-js/react-reconciler/src"
						},
						"Scheduler": {
							"$path": "node_modules/@rbxts-js/scheduler/src"
						},
						"Shared": {
							"$path": "node_modules/@rbxts-js/shared/src"
						}
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true
			},
			"Baseplate": {
				"$className": "Part",
				"$properties": {
					"Size": [512, 20, 512],
					"Position": [0, -10, 0],
					"Anchored": true,
					"Color": [0.25, 0.25, 0.25],
					"Material": "Plastic"
				}
			}
		},
		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},
		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
